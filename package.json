{
  "name": "col7a1-variant-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python3 scripts/process_data.py",
    "verify:data": "python3 scripts/verify_data.py",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && node --test tests/frontend.test.mjs tests/dataset-validation.test.mjs tests/explorer-state.test.mjs tests/chart-data.test.mjs tests/theme.test.mjs tests/map-data.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "verify:snapshot": "python3 scripts/verify_data.py --snapshot"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
